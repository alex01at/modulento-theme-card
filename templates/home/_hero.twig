{# Receives block: texts (title, text, button_label, button_url). No catalogue search here -
   the card extension has no offer type, so there is nothing to search for. #}
<section class="hero">
    <div class="container narrow">
        <span class="hero-badge">{{ trans('theme.hero.badge') }}</span>
        <h1 data-field="title">{{ block.texts.title }}</h1>
        {% if block.texts.text or edit_mode() %}<p class="lead" data-field="text">{{ block.texts.text }}</p>{% endif %}
        <div class="hero-actions">
            {% if block.texts.button_label and block.texts.button_url %}
                <a class="button large" href="{{ block.texts.button_url starts with '/' ? url(block.texts.button_url) : block.texts.button_url }}">{{ block.texts.button_label }}</a>
            {% endif %}
            {% if module('subscriptions') %}
                <a class="button ghost large" href="{{ url('/subscriptions') }}">{{ trans('theme.hero.secondary') }}</a>
            {% endif %}
        </div>
    </div>
</section>
